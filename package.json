{
  "name": "@odiobill/piren",
  "version": "0.2.0-internal.17",
  "type": "module",
  "description": "Piren: lightweight, local-first agent layer on top of Pi Coding Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Odiobill/piren.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "docs/"
  ],
  "bin": {
    "piren": "dist/src/cli.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-templates.ts && vite build --config web/vite.config.ts",
    "smoke": "tsx scripts/smoke.ts",
    "clean-install:check": "tsx scripts/clean-install-check.ts"
  },
  "dependencies": {
    "typebox": "1.2.19",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.15"
  }
}
