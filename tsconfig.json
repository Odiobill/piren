{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests/web-p8-browser-layout.test.ts",
    "tests/web-p8-autoscroll-wiring.test.ts",
    "tests/web-p8-composer-focus.test.ts",
    "tests/web-conversation-details-modal.test.ts",
    "tests/web-conversation-composer.test.ts",
    "tests/web-p1-conversation-surface.test.ts",
    "tests/p4-safe-markdown-jsdom.test.ts",
    "tests/web-conversation-scroll-anchor.test.ts",
    "tests/web-p6-details-toggle.test.ts",
    "tests/web-r1-root-scroll.test.ts",
    "tests/web-r2-transient-cleanup.test.ts",
    "tests/web-dashboard-view.test.ts",
    "tests/web-dashboard-service-observation.test.ts",
    "tests/web-d4-activity-handoff.test.ts",
    "tests/web-conversation-telemetry-ui.test.ts",
    "tests/web-conversation-telemetry-timeline.test.ts",
    "tests/web-tracer-b-history-tray.test.ts",
    "tests/web-tracer-b-navigator.test.ts",
    "tests/web-approval-pager-component.test.ts",
    "tests/web-action-icons.test.ts",
    "tests/web-sidebar.test.ts",
    "tests/web-split-resizer-component.test.ts",
    "tests/web-split-shell-component.test.ts",
    "tests/web-w1-browser-layout.test.ts"
  ]
}
